# ============================================
# CDC Service Request - Root .gitignore
# ============================================

# Dependencies
node_modules/

# Build output
dist/

# Environment variables (sensitive!)
.env
*.env

# Database files (auto-generated by Docker seed)
*.db
*.db-journal

# macOS system files
.DS_Store
.AppleDouble
.LSOverride

# Logs
logs/
*.log
npm-debug.log*

# Editor directories
.vscode/
.idea/

# Uploaded files (user content, not tracked in git)
backend/uploads/*
!backend/uploads/.gitkeep
