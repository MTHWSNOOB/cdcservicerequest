# ============================================
# CDC Service Request - Backend Environment
# ============================================
# Copy this file to .env and fill in the values
# cp .env.example .env

PORT=3000
NODE_ENV=production
APP_NAME=CDC_SERVICE_BACKEND

# Database (SQLite - path inside Docker container)
DATABASE_URL="file:/app/data/dev.db"

# JWT Secret - CHANGE THIS to a strong random string in production!
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=super-secret-key-cdc
