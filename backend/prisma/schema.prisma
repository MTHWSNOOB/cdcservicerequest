generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TECHNICAL
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RequestStatus {
  NEW
  RECEIVED
  APPROVED
  DISAPPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  password        String           // Added for authentication
  role            UserRole         @default(USER)
  status          UserStatus       @default(ACTIVE)
  avatar          String?
  sectionId       String?
  section         Section?         @relation("UserSection", fields: [sectionId], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  serviceRequests ServiceRequest[]
  receivedRequests ServiceRequest[] @relation("ReceivedRequests")
  notifications   Notification[]
}

model Department {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String    @unique
  sections  Section[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Section {
  id              String           @id @default(uuid())
  name            String
  departmentId    String
  department      Department       @relation(fields: [departmentId], references: [id])
  users           User[]           @relation("UserSection")
  serviceRequests ServiceRequest[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([name, departmentId])
}

model RequestType {
  id              String           @id @default(uuid())
  name            String           @unique
  serviceRequests ServiceRequest[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model ServiceRequest {
  id            String         @id @default(uuid())
  subject       String
  urgency       Urgency        @default(MEDIUM)
  status        RequestStatus  @default(NEW)
  description   String?
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  sectionId     String
  section       Section        @relation(fields: [sectionId], references: [id])
  requestTypeId String
  requestType   RequestType    @relation(fields: [requestTypeId], references: [id])
  receivedAt    DateTime?
  receivedById  String?
  receivedBy    User?          @relation("ReceivedRequests", fields: [receivedById], references: [id])
  attachments   String?
  disapprovalReason String?
  actionsTaken      String?
  remarks           String?
  assignedAdmins    String?
  rating            Int?
  feedback          String?
  deadline          DateTime?
  deletionRequested Boolean        @default(false)
  notifications Notification[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Notification {
  id               String         @id @default(uuid())
  message          String
  isRead           Boolean        @default(false)
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  serviceRequestId String?
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id])
  createdAt        DateTime       @default(now())
}
